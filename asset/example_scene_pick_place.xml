<mujoco model="PickPlaceBasket">
    <!-- Franka FR3 + Franka Hand; apple and green mug into the fixed rattan basket.
         Robot state/action contract: 7 actual arm joints / 7 arm targets + closure.
         External cameras retain their names; egocentric is mounted on the FR3 hand. -->

    <!-- Memory? -->
    <size memory="500M"/>

    <!-- Default options -->
    <option integrator="RK4" noslip_iterations="20" />
    <default>
        <joint armature="0.1" damping="0.1" />
        <default class="visual_only">
            <geom type="mesh" contype="0" conaffinity="0" group="2" />
        </default>
        <default class="no_visual_collision">
            <!-- visual group of 'collision' should be 3 to not render -->
            <geom type="capsule" solimp=".9 .99 .001" solref=".015 1" group="3" />
        </default>
        <default class="visual_collision">
            <geom type="mesh" solimp=".9 .99 .001" solref=".015 1" group="2" />
        </default>
    </default>

    <!-- Sky and floor -->
    <include file="./tabletop/object/floor_isaac_style.xml" />

    <!-- Table -->
    <include file="./tabletop/object/object_table.xml" />

    <!-- Robot -->
    <include file="./franka_fr3/fr3.xml" />

    <!-- Objects: apple + green mug -->
    <include file="./fruit/fruit_apple.xml" />
    <include file="./objaverse/mug_6/model_new.xml" />

    <!-- Basket (fixed) -->
    <include file="./fruit/fruit_basket.xml" />
</mujoco>
